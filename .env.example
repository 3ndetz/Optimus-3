# CRITICAL: Prevents crashes when a specific math operation isn't implemented on MPS yet.
# It forces PyTorch to briefly switch to CPU for that one op, then go back to GPU.
# PYTORCH_ENABLE_MPS_FALLBACK=1

# OPTIONAL: Removes the memory limit "safety cap".
# Useful if you are hitting "out of memory" errors but know your Mac has unified memory available.
# PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0

# OPTIONAL: Only works if your script uses the Hugging Face 'Accelerate' library.
# This tells Accelerate to default to MPS without asking.
# ACCELERATE_TORCH_DEVICE=mps